rules_version = '2';

// ==============================================
// Regras de segurança do Firestore
// ==============================================
// O cadastro é aberto: qualquer conta Google entra. Então estas regras são a
// única coisa entre uma pessoa desconhecida e os dados de outra.
//
// A ideia é uma só: todo dado de usuário mora embaixo de /users/{uid}, e só o
// dono daquele uid alcança aquele caminho. Não existe coleção de dados fora
// daí, então não existe dado sem dono.
//
// O Firestore nega por padrão. O que não estiver liberado aqui é proibido.

service cloud.firestore {
  match /databases/{database}/documents {

    // Está logada, e é a dona deste espaço?
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // O documento de perfil.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // E tudo que estiver pendurado embaixo dele, em qualquer profundidade:
      // tasks, habits, goals, notes, bills, transactions, days.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
